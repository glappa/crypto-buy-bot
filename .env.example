# Token from @BotFather. Separate several bots (e.g. one per project) with commas:
# BOT_TOKENS=111:AAA,222:BBB
BOT_TOKENS=

# Optional
POLL_SECONDS=15
DB_PATH=buybot.db
# LOG_FILE=buybot.log        # default: next to DB_PATH
# CATCH_UP_MINUTES=30         # after a restart, post missed trades up to this old

# Optional: own RPC endpoints for the "New Holder" check (public ones are used by default)
# RPC_BASE=https://mainnet.base.org
# RPC_SOLANA=https://api.mainnet-beta.solana.com
# RPC_ETH=https://ethereum-rpc.publicnode.com
# RPC_BSC=https://bsc-dataseed.bnbchain.org
